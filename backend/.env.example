DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Render: optional — if unset, hostname is taken from RENDER_EXTERNAL_URL when deployed there.
# DATABASE_URL=postgres://...   # Render PostgreSQL “External Database URL” for persistence (recommended)

CORS_ALLOW_ALL_ORIGINS=1

# Paid / optional — omit for a fully free stack: haversine travel times, Photon/Nominatim discover, client-star popularity.
# OPENROUTESERVICE_API_KEY=
# FOURSQUARE_API_KEY=

# Optional: OpenAI for richer copy and a short trip summary
# OPENAI_API_KEY=

# Wikimedia/Nominatim user-agent (identify your app)
APP_USER_AGENT=wanderlist/1.0 (contact: yourname@email.com)

# MapTiler maps run in the browser — set NEXT_PUBLIC_MAPTILER_KEY in the repo root .env (see ../.env.example), not here.
