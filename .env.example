# ── Next.js (repo root) — copy to `.env` or `.env.local` ─────────────────────
# Next.js does not read backend/.env. Do not put NEXT_PUBLIC_* in backend/.env.
#
# Leave NEXT_PUBLIC_API_BASE_URL unset to use same-origin /api (proxied to Django in dev by next.config.mjs).
# Or set it explicitly, e.g. http://127.0.0.1:8000/api
# NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_MAPTILER_KEY=

# Static export (GitHub Pages): npm run build fails rewrites; point the browser at your API.
# NEXT_STATIC_EXPORT=1
# NEXT_PUBLIC_API_BASE_URL=https://your-django-host.example.com/api

# Override Django origin for the dev proxy (defaults to http://127.0.0.1:8000)
# BACKEND_URL=http://127.0.0.1:8000

# Render (Next web service): set BACKEND_URL to your Django service URL, no trailing slash —
# render.yaml wires this via fromService → RENDER_EXTERNAL_URL on the backend.

# ── Django — use backend/.env (see backend/.env.example) ──────────────────────
# Itinerary uses free haversine travel times when OPENROUTESERVICE_API_KEY is unset.
# OPENROUTESERVICE_API_KEY=
# FOURSQUARE_API_KEY=
